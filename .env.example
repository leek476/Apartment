# Copy this file to .env.local and replace the placeholders with your own values.
# Create the API key in Resend; it is not the Supabase publishable/anon key.
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=you@example.com
# Use an address on a domain verified in Resend, for example: RentBridge <requests@yourdomain.com>
RESEND_FROM_EMAIL=RentBridge <requests@your-verified-domain.com>
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
